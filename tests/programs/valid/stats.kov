// A slightly larger program: accumulating statistics over a range.
//
// Shows structs holding state, compound assignment, enums as results,
// and early returns.
//
//     kove run examples/stats.kov

struct Summary {
    count: Int,
    total: Int,
    smallest: Int,
    largest: Int
}

enum Shape {
    Empty,
    Single,
    Spread
}

fn collatz_steps(start: Int) -> Int {
    let mut n = start;
    let mut steps = 0;
    while n != 1 {
        if n % 2 == 0 {
            n /= 2;
        } else {
            n *= 3;
            n += 1;
        }
        steps += 1;
    }
    return steps;
}

fn empty_summary() -> Summary {
    // `smallest` starts high and `largest` low so the first observation
    // replaces both.
    return Summary {
        count: 0,
        total: 0,
        smallest: 9223372036854775807,
        largest: 0 - 9223372036854775807
    };
}

fn observe(summary: Summary, value: Int) -> Summary {
    let mut next = summary;
    next.count += 1;
    next.total += value;
    if value < next.smallest {
        next.smallest = value;
    }
    if value > next.largest {
        next.largest = value;
    }
    return next;
}

fn mean(summary: Summary) -> Int {
    if summary.count == 0 {
        return 0;
    }
    return summary.total / summary.count;
}

fn shape(summary: Summary) -> Shape {
    if summary.count == 0 {
        return Shape::Empty;
    }
    if summary.smallest == summary.largest {
        return Shape::Single;
    }
    return Shape::Spread;
}

fn describe(s: Shape) -> String {
    if s == Shape::Empty {
        return "nothing measured";
    }
    if s == Shape::Single {
        return "every value the same";
    }
    return "a spread of values";
}

fn main() {
    let mut summary = empty_summary();
    for start in 2..12 {
        summary = observe(summary, collatz_steps(start));
    }

    println("collatz steps for 2..12");
    println(describe(shape(summary)));
    println(summary.count);
    println(summary.smallest);
    println(summary.largest);
    println(mean(summary));

    // \u{2026} is a horizontal ellipsis.
    println("done\u{2026}");
}
