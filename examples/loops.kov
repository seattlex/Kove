// While-loops, for-loops over ranges, and mutability.

fn main() {
    let mut count = 0;
    while count < 3 {
        println(count);
        count = count + 1;
    }

    // Ranges are half-open: 1..4 visits 1, 2, 3.
    let mut total = 0;
    for i in 1..4 {
        total = total + i;
    }
    println(total);
}
